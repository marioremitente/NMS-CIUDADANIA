rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin(){
      return request.auth != null
             && (
               request.auth.token.email == 'remitente2008@gmail.com'
               || request.auth.token.email == 'moringostv@gmail.com'
             );
    }

    // El dueño (mismo ownerUid) puede editar los datos de SU propia base:
    // - photoUrl/photoStatus: foto DE LA BASE (sale en la galería pública)
    // - idPhotoUrl/idPhotoStatus: foto DEL CARNET (solo en la credencial,
    //   nunca en la galería — son campos separados a propósito)
    // - profesión, plataforma y código de amigo
    // Cualquier foto que suba siempre vuelve a "pending" — nunca puede
    // auto-aprobarse. Nunca puede tocar status, role, rejectionReason,
    // ownerUid/ownerEmail, ni ningún otro campo.
    function isOwnerLimitedUpdate(){
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.auth != null
             && resource.data.ownerUid == request.auth.uid
             && changed.hasOnly(['photoUrl','photoStatus','idPhotoUrl','idPhotoStatus','profession','platform','friendCode'])
             && (!changed.hasAny(['photoStatus']) || request.resource.data.photoStatus == 'pending')
             && (!changed.hasAny(['idPhotoStatus']) || request.resource.data.idPhotoStatus == 'pending');
    }

    match /citizens/{citizenId} {
      // Cualquiera puede leer el registro (la lista pública lo necesita)
      allow read: if true;

      // Cualquiera puede crear una solicitud nueva desde el formulario público,
      // pero siempre debe entrar como "pending" — nadie puede auto-aprobarse.
      // Campos opcionales del portal: signature, hexAddress, cartesian, systemIndex.
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.keys().hasAll(['id','name','planetIndex','lat','lon','status','ts']);

      allow update: if isAdmin() || isOwnerLimitedUpdate();

      // Solo los admins pueden borrar solicitudes.
      allow delete: if isAdmin();
    }

    // Contador de bytes usados en Storage. Lo lee la barra de uso del
    // admin, y también lo leen las reglas de Storage antes de aceptar
    // cualquier subida nueva (ver storage.rules).
    match /meta/storageUsage {
      allow read: if true;
      allow create: if isAdmin();
      // Los admins pueden ajustarlo libremente (por ejemplo, al borrar una
      // foto se descuenta su tamaño). Cualquier usuario autenticado puede
      // incrementarlo tras subir una foto suya — pero SOLO puede subir el
      // número, nunca bajarlo, y nunca de un salto mayor a 5MB (el máximo
      // de un archivo), para que nadie pueda manipular el contador.
      allow update: if isAdmin()
                    || (
                      request.auth != null
                      && request.resource.data.keys().hasOnly(['bytesUsed'])
                      && request.resource.data.bytesUsed is number
                      && request.resource.data.bytesUsed > resource.data.bytesUsed
                      && request.resource.data.bytesUsed <= resource.data.bytesUsed + (5 * 1024 * 1024)
                    );
    }

    // Foto de referencia de cada planeta. Solo el admin las sube; cualquiera puede leerlas.
    match /planetImages/{planetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Colonias ──────────────────────────────────────────────────────
    match /colonies/{colonyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Sistemas registrados ─────────────────────────────────────────
    match /systems/{systemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ─── Fotos de bases adicionales (galería extra) ───────────────────
    match /citizenBases/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
